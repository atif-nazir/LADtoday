# LADtoday — Environment Variables
# Copy to .env.local for frontend, supabase/.env for Edge Functions

# ─── SUPABASE ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── BRIGHT DATA (required — get from brightdata.com) ────────────────────────
# Promo code: unlocked (get $250 credits)
BRIGHTDATA_API_TOKEN=your_brightdata_api_token
BRIGHTDATA_USERNAME=brd-customer-CUSTOMER_ID-zone-unlocker
BRIGHTDATA_PASSWORD=your_zone_password
BRIGHTDATA_CUSTOMER_ID=YOUR_CUSTOMER_ID

# ─── AI MODELS ────────────────────────────────────────────────────────────────
# Gemini (core model — free tier available)
GEMINI_API_KEY=your_gemini_api_key

# AI/ML API (for $1,000 challenge prize — claim $10 credits first)
AIML_API_KEY=your_aiml_api_key

# ─── COGNEE (agent memory — $500 Amazon prize) ───────────────────────────────
COGNEE_API_KEY=your_cognee_api_key

# ─── TRIGGERWARE.AI ($300 Amazon prize) ──────────────────────────────────────
TRIGGERWARE_WEBHOOK_URL=https://app.triggerware.ai/webhooks/YOUR_WEBHOOK_ID

# ─── PUBLISHING PLATFORMS (optional for demo) ────────────────────────────────
WORDPRESS_URL=https://your-site.com
WORDPRESS_JWT_TOKEN=your_jwt_token

FACEBOOK_ACCESS_TOKEN=your_fb_access_token
FACEBOOK_PAGE_ID=your_page_id
