# ============================================================
# LADtoday Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ─── FRONTEND (Required) ────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── SUPABASE (Set via: supabase secrets set) ──────────────

# Core AI (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Bright Data (Optional - bypasses bot detection)
# Get from: https://brightdata.com/
BRIGHTDATA_API_TOKEN=your_brightdata_api_token
BRIGHTDATA_USERNAME=your_brightdata_username
BRIGHTDATA_PASSWORD=your_brightdata_password
BRIGHTDATA_CUSTOMER_ID=your_brightdata_customer_id

# AI/ML API (Optional - GPT-4o for Intelligence agent)
# Get from: https://aimlapi.com/
AIML_API_KEY=your_aiml_api_key
USE_AIML_API=true

# Cognee (Optional - memory/learning system)
# Get from: https://www.cognee.ai/
COGNEE_API_KEY=your_cognee_api_key
USE_COGNEE=true

# Firecrawl (Optional - web scraping)
# Get from: https://firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Lobster Trap (Security - enabled by default)
LOBSTER_TRAP_ENABLED=true

# ─── NOTES ──────────────────────────────────────────────────
# 
# Required Services:
# - Supabase (URL, anon key, service role key)
# - Gemini API (for all AI agents)
#
# Optional Services (with fallbacks):
# - Bright Data → Falls back to Firecrawl/Gemini/DuckDuckGo
# - AI/ML API → Falls back to Gemini
# - Cognee → Falls back to database learning
# - Firecrawl → Falls back to Gemini grounding/DuckDuckGo
#
# Security:
# - Never commit .env files to git
# - Use Supabase secrets for backend keys
# - Only use VITE_ prefix for frontend variables
#
# ============================================================
